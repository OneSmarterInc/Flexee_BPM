# Local backend example only. Render supplies PORT in its environment.
PORT=3001
# Set a real PostgreSQL URL in the backend process environment, never commit it.
DATABASE_URL=
# Optional isolated integration database; name must end in _test.
TEST_DATABASE_URL=
LLM_PROVIDER=deterministic
LLM_API_KEY=
# The only application variable for Vercel; public and embedded at build time.
# /api requires same-origin hosting or an approved reverse proxy.
VITE_API_BASE=/api
FLEXEE_INSTRUCTOR_PASSPHRASE=
