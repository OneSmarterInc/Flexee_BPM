# Documentation template only. Scripts read process.env; this file is NOT auto-loaded.
# Supply values through local process settings or backend host secrets. Never commit credentials.

# BACKEND: required PostgreSQL URL and existing instructor authentication secret.
DATABASE_URL=
FLEXEE_INSTRUCTOR_PASSPHRASE=
# Local only. Render supplies PORT; do not override it with this local value.
PORT=3001
# Local non-SSL PostgreSQL: NODE_ENV=development and FLEXEE_POSTGRES_SSL=disable.
# Render: NODE_ENV=production and FLEXEE_POSTGRES_SSL=require (or unset).
# require preserves the pilot TLS policy; see the audit's certificate-verification risk.
# PGSSLMODE=require/disable also works; if both SSL variables are set they must agree.
# URL SSL query parameters are rejected. Remote/production disable is rejected.
NODE_ENV=development
FLEXEE_POSTGRES_SSL=require
# Set 1 only after verifying a single trusted proxy overwrites X-Forwarded-For
# and that clients cannot reach this service through a shorter path.
TRUST_PROXY_HOPS=0

# TESTS ONLY: separate disposable PostgreSQL database ending in _test.
TEST_DATABASE_URL=

# Current conversation provider is deterministic; no external API key is required.
LLM_PROVIDER=deterministic
LLM_API_KEY=

# FRONTEND ONLY: public build-time API base. Local same-origin/proxy uses /api.
# On Vercel set the HTTPS backend base ending in /api, without a trailing slash.
# Never put database or instructor secrets in VITE_* variables.
VITE_API_BASE=/api
