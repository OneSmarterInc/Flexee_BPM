{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist/backend",
    "types": ["node"],
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/server/index.ts"],
  "exclude": ["node_modules", "dist"]
}
